# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5433/csrms_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Server Configuration
PORT=2000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:6000

# Frontend URL (password reset links)
FRONTEND_URL=http://localhost:6000/frontend

# Email Configuration (optional — for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Legacy email keys (unused)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Application Settings
APP_NAME=CSRMS
APP_VERSION=1.0.0
