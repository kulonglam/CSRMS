# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=csrms_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=development

# CORS (comma-separated origins; use * only in development)
CORS_ORIGIN=http://localhost:5000

# Frontend URL for password-reset email links
FRONTEND_URL=http://localhost:5000

# Email (optional — password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Application
APP_NAME=CSRMS
APP_VERSION=1.0.0
